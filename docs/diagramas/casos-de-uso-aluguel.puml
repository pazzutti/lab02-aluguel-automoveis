@startuml casos_de_uso_aluguel
' =====================================================================
' Sistema de Aluguel de Automoveis
' Diagrama de Casos de Uso - Lab02S01
' Fonte versionada em docs/diagramas/casos-de-uso-aluguel.puml
' Casos de uso derivados das Historias de Usuario (docs/historias-de-usuario.md)
' =====================================================================

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FDFDFD
  BorderColor #444444
}

' ============================== ATORES ===============================
actor Visitante
actor Usuario
actor Cliente
actor Agente
actor Empresa
actor Banco

Cliente --|> Usuario
Agente --|> Usuario
Empresa --|> Agente
Banco --|> Agente

rectangle "Sistema de Aluguel de Automoveis" {

  ' --- Cadastro e acesso (HU01-HU04) ---
  usecase "Cadastrar-se como cliente - UC01" as UC01
  usecase "Cadastrar-se como agente - UC02" as UC02
  usecase "Realizar login - UC03" as UC03
  usecase "Manter dados cadastrais - UC04" as UC04

  ' --- Pedido de aluguel (Cliente) (HU05-HU09) ---
  usecase "Consultar automoveis disponiveis - UC05" as UC05
  usecase "Criar pedido de aluguel - UC06" as UC06
  usecase "Consultar meus pedidos - UC07" as UC07
  usecase "Alterar pedido de aluguel - UC08" as UC08
  usecase "Cancelar pedido de aluguel - UC09" as UC09

  ' --- Avaliacao do pedido (Agente) (HU10-HU12) ---
  usecase "Consultar pedidos pendentes de analise - UC10" as UC10
  usecase "Analisar pedido - UC11" as UC11
  usecase "Registrar parecer sobre o pedido - UC12" as UC12

  ' --- Contratacao (HU14-HU19) ---
  usecase "Decidir sobre pedido aprovado - UC14" as UC14
  usecase "Gerar contrato de aluguel - UC15" as UC15
  usecase "Conceder contrato de credito (leasing) - UC16" as UC16
  usecase "Registrar devolucao do veiculo - UC18" as UC18
  usecase "Consultar meus contratos - UC19" as UC19

  ' --- Gestao de automoveis (Empresa) (HU20) ---
  usecase "Manter cadastro de automoveis - UC20" as UC20
}

' ============================ ASSOCIACOES =============================

Visitante --> UC01
Visitante --> UC02
Visitante --> UC03

Usuario --> UC04
Usuario --> UC19

Cliente --> UC05
Cliente --> UC06
Cliente --> UC07
Cliente --> UC08
Cliente --> UC09
Cliente --> UC14

Agente --> UC10
Agente --> UC11
Agente --> UC12

Empresa --> UC18
Empresa --> UC20

Banco --> UC16

' ========================= INCLUDE / EXTEND ============================

UC06 ..> UC05 : <<include>>
UC14 ..> UC15 : <<include>>\n(quando aceito)
UC15 ..> UC16 : <<extend>>\n(modalidade leasing)

@enduml
